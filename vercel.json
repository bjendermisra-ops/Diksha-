{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/i/:token*",
      "destination": "/index.html"
    },
    {
      "source": "/i/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/invite",
      "destination": "/index.html"
    }
  ]
}
